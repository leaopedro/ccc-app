{
  "extends": "@jdm/tsconfig/react-native.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@jdm/design": ["../design/src/index.ts"],
      "@jdm/design/*": ["../design/src/*"]
    },
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "vitest.config.ts", "test-stubs/**/*", "nativewind-env.d.ts"]
}

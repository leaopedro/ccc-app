{
  "extends": "@ccc/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@ccc/shared/legal": ["../../packages/shared/src/legal.ts"]
    },
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "references": [
    { "path": "../../packages/design" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/ui" }
  ],
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

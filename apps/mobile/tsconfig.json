{
  "extends": "@ccc/tsconfig/react-native.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@ccc/shared": ["../../packages/shared/src/index.ts"],
      "@ccc/shared/*": ["../../packages/shared/src/*"],
      "@ccc/design": ["../../packages/design/src/index.ts"],
      "@ccc/design/*": ["../../packages/design/src/*"],
      "@ccc/ui": ["../../packages/ui/src/index.ts"],
      "@ccc/ui/*": ["../../packages/ui/src/*"],
      "@ccc/shared/legal": ["../../packages/shared/src/legal.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "app.config.ts",
    "vitest.config.ts",
    "test-stubs/**/*",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}

{
  "extends": "@ccc/tsconfig/react-native.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ccc/shared": ["../shared/src/index.ts"],
      "@ccc/shared/*": ["../shared/src/*"],
      "@ccc/design": ["../design/src/index.ts"],
      "@ccc/design/*": ["../design/src/*"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts", "test-stubs/**/*", "nativewind-env.d.ts"]
}

{
  "name": "@ccc/design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./brand": {
      "types": "./src/brand.ts",
      "default": "./dist/brand.js"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "assets/*.webp",
    "assets/*.png",
    "brand.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint'"
  },
  "devDependencies": {
    "@ccc/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
